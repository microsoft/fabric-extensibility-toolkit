{
  "version": "2.0",
  "agents": [
    {
      "name": "fabric",
      "description": "Microsoft Fabric Development Expert -- Specialized assistant for Fabric platform development, Extensibility Toolkit implementation, and workload creation",
      "prompt_file": "fabric-agent.md",
      "knowledge_files": [
        "../../.ai/references/fabric-platform.md",
        "../../.ai/skills/fabric-items/SKILL.md",
        "../../.ai/skills/fabric-items/references/item-components.md",
        "../../.ai/skills/fabric-workloads/SKILL.md"
      ],
      "capabilities": [
        "code_generation",
        "architecture_guidance",
        "security_implementation",
        "api_integration",
        "testing_strategies",
        "deployment_automation"
      ],
      "domains": [
        "typescript",
        "react",
        "azure",
        "authentication",
        "data_engineering",
        "business_intelligence"
      ],
      "context_patterns": [
        "Workload/app/**/*.ts",
        "Workload/app/**/*.tsx",
        "Workload/Manifest/**/*.xml",
        "Workload/Manifest/**/*.json",
        "scripts/**/*.ps1"
      ],
      "activation_keywords": [
        "fabric",
        "workload",
        "extensibility-toolkit",
        "onelake",
        "powerbi",
        "entra",
        "authentication",
        "manifest",
        "item",
        "editor",
        "ribbon"
      ]
    }
  ],
  "default_context": [
    ".ai/references/fabric-platform.md",
    ".ai/skills/fabric-items/SKILL.md",
    ".ai/skills/fabric-workloads/SKILL.md"
  ],
  "workspace_patterns": {
    "include": [
      "Workload/app/**",
      "Workload/Manifest/**",
      "scripts/**",
      ".ai/references/**",
      ".ai/skills/**"
    ],
    "exclude": [
      "node_modules/**",
      "release/**",
      "tools/**",
      "*.log"
    ]
  }
}
